generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model agendas {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  data       DateTime
  itemId     String    @db.ObjectId
  clienteId  String    @db.ObjectId
  enderecoId String    @db.ObjectId
  observacao String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  clientes   clientes  @relation(fields: [clienteId], references: [id])
  enderecos  enderecos @relation(fields: [enderecoId], references: [id])
  estoques   estoques  @relation(fields: [itemId], references: [id])
}

model clientes {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  cpf       String?
  contato   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  agendas   agendas[]
  enderecos enderecos[]
}

model enderecos {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  clienteId   String    @db.ObjectId
  cep         String
  bairro      String?
  rua         String
  numero      String
  complemento String?
  principal   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  agendas     agendas[]
  clientes    clientes  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model estoques {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  peso        Float
  largura     Float
  altura      Float
  valorDiaria Float
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quantidade  Int       @default(0)
  disponivel  Int       @default(0)
  agendas     agendas[]
}

model usuarios {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  loginName String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
