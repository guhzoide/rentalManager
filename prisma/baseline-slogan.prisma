generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model empresas {
  id          String   @id @default(uuid()) @db.Citext
  nome        String   @db.Citext
  logoUrl     String?  @db.Text
  slogan      String?  @db.Citext
  cnpj        String?  @db.Citext
  telefone    String?  @db.Citext
  logradouro  String?  @db.Citext
  numero      String?  @db.Citext
  cep         String?  @db.Citext
  bairro      String?  @db.Citext
  complemento String?  @db.Citext
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model agendas {
  id         String         @id @default(uuid()) @db.Citext
  data       DateTime
  clienteId  String         @db.Citext
  enderecoId String         @db.Citext
  observacao String?        @db.Citext
  dataColeta DateTime       @default(now())
  desconto   Float          @default(0)
  frete      Float          @default(0)
  valorTotal Float          @default(0)
  concluida  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  clientes   clientes       @relation(fields: [clienteId], references: [id])
  enderecos  enderecos      @relation(fields: [enderecoId], references: [id])
  itens      agenda_itens[]
}

model agenda_itens {
  id         String   @id @default(uuid()) @db.Citext
  agendaId   String   @db.Citext
  itemId     String   @db.Citext
  quantidade Int      @default(1)
  agendas    agendas  @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  estoques   estoques @relation(fields: [itemId], references: [id])
}

model clientes {
  id        String      @id @default(uuid()) @db.Citext
  nome      String      @db.Citext
  contato   String      @db.Citext
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cpf       String?     @db.Citext
  email     String?     @db.Citext
  agendas   agendas[]
  enderecos enderecos[]
}

model enderecos {
  id          String    @id @default(uuid()) @db.Citext
  clienteId   String    @db.Citext
  cep         String    @db.Citext
  rua         String    @db.Citext
  numero      String    @db.Citext
  complemento String?   @db.Citext
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bairro      String?   @db.Citext
  principal   Boolean   @default(false)
  agendas     agendas[]
  clientes    clientes  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model estoques {
  id          String         @id @default(uuid()) @db.Citext
  nome        String         @db.Citext
  peso        Float
  largura     Float
  altura      Float
  valorDiaria Float
  /// Capa e galeria em base64 com prefixo data:image, nunca URLs externas.
  imageUrl    String?        @db.Text
  imageUrls   String[]       @default([]) @db.Text
  ativo       Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  quantidade  Int            @default(0)
  disponivel  Int            @default(0)
  itens       agenda_itens[]
}

model User {
  id            String       @id @default(uuid()) @db.Citext
  name          String       @db.Citext
  email         String       @db.Citext
  emailVerified Boolean      @default(false)
  image         String?      @db.Citext
  atendente     Boolean      @default(false)
  master        Boolean      @default(false)
  whatsapp      String?      @db.Citext
  grupoCodigo   Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  documentos    documentos[]

  @@unique([email])
  @@map("user")
}

model modulos {
  id        String   @id @db.Citext
  nome      String   @db.Citext
  descricao String?  @db.Citext
  icone     String   @db.Citext
  ordem     Int
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model grupos {
  id        String   @id @default(uuid()) @db.Citext
  codigo    Int      @unique @default(autoincrement())
  nome      String   @db.Citext
  descricao String?  @db.Citext
  moduloIds String[] @default([]) @db.Citext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid()) @db.Citext
  expiresAt DateTime
  token     String   @db.Citext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Citext
  userAgent String?  @db.Citext
  userId    String   @db.Citext
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Citext
  accountId             String    @db.Citext
  providerId            String    @db.Citext
  userId                String    @db.Citext
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Citext
  refreshToken          String?   @db.Citext
  idToken               String?   @db.Citext
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Citext
  password              String?   @db.Citext
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Citext
  identifier String   @db.Citext
  value      String   @db.Citext
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model transacoes {
  id        String   @id @default(uuid()) @db.Citext
  descricao String   @db.Citext
  valor     Float
  tipo      String   @db.Citext
  data      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model documentos {
  id        String   @id @default(uuid()) @db.Citext
  nome      String   @db.Citext
  content   Json
  usuarioId String?  @db.Citext
  usuario   User?    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
}
